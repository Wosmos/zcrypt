# zcrypt backend, environment configuration
#
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# NEVER commit a real .env file. It is gitignored on purpose.
# Every contributor must supply their own credentials.

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (e.g. a Neon serverless database).
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# 32-byte hex key for envelope encryption of platform tokens at rest.
# Generate one with: openssl rand -hex 32
MASTER_KEY=replace-with-32-byte-hex-key

# JWT signing secret. If left empty the server auto-generates an ephemeral one
# (tokens will not survive a restart), so set a stable value in production.
# Generate one with: openssl rand -hex 32
ZCRYPT_JWT_SECRET=replace-me

# Frontend URL: used for email links and the post-OAuth redirect, and added
# to the CORS whitelist automatically. No trailing slash in production.
FRONTEND_URL=http://localhost:3000

# Public backend URL (e.g. https://NEXT_PUBLIC_API_URL), no trailing slash.
# Required for OAuth: it builds the redirect_uri and must EXACTLY match what is
# registered with Google/GitHub. If unset it is derived per-request, which
# usually breaks OAuth.
BACKEND_URL=http://localhost:8080

# Comma-separated CORS whitelist. Defaults to localhost; FRONTEND_URL is added
# automatically.
ALLOWED_ORIGINS=http://localhost:3000

# ── OAuth (optional) ──────────────────────────────────────────────────────────
# A provider is enabled only when BOTH its client ID and secret are set.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email (optional) ──────────────────────────────────────────────────────────
# Used for email verification and password reset via Resend.

RESEND_API_KEY=
RESEND_FROM=zcrypt <noreply@example.com>

# ── Server (optional) ─────────────────────────────────────────────────────────

# Server port (default: 8080). On some hosts (e.g. Railway) PORT is injected.
ZCRYPT_PORT=8080

# Set to "true" ONLY for local load testing, disables all rate limiting.
# NEVER enable this in production.
DEV_MODE=false

# ── Limits (optional) ─────────────────────────────────────────────────────────
# Sizes are in bytes. A bad value falls back to the default shown. For the three
# RELAY values, 0 means unlimited, and admins are never limited.

# Sign-in, sign-up and session refresh from cloud and data-center networks (AWS,
# Google Cloud, Azure, Oracle, DigitalOcean, Hetzner and others): block (default),
# flag (let in, record in the audit log) or off.
# ZCRYPT_CLOUD_NETWORKS=block
# Addresses or CIDRs that always pass that block, comma separated.
# ZCRYPT_NETWORK_ALLOW=203.0.113.7,198.51.100.0/24

# Cloudflare Turnstile secret: turns on the bot check for web sign-up, sign-in,
# sign-in links and password reset (the frontend needs NEXT_PUBLIC_TURNSTILE_SITE_KEY).
# TURNSTILE_SECRET_KEY=

# Largest file a web upload may send through the server (default 2 GiB).
# ZCRYPT_RELAY_MAX_FILE_BYTES=2147483648

# Web transfers (uploads through the server plus downloads) per user per UTC month (default 20 GiB).
# ZCRYPT_RELAY_MONTHLY_BYTES=21474836480

# Flags a user as a heavy web-transfer user in the admin console (default 10 GiB over today plus yesterday).
# ZCRYPT_RELAY_ALERT_DAILY_BYTES=10737418240

# Storage cap for users on the shared pool (default 1 GiB).
# ZCRYPT_SHARED_QUOTA_BYTES=1073741824

# Largest single file (default 10 GiB).
# ZCRYPT_MAX_UPLOAD_BYTES=10737418240

# Send allowance per rolling 24 hours: anonymous senders per network (default 500 MiB), signed-in senders (default 5 GiB).
# ZCRYPT_SEND_ANON_DAILY_BYTES=524288000
# ZCRYPT_SEND_USER_DAILY_BYTES=5368709120

# PostgreSQL connection pool ceiling (default 25).
# ZCRYPT_DB_MAX_CONNS=25

# GitHub owner/name that download links and update checks read releases from.
# ZCRYPT_RELEASES_REPO=Wosmos/zcrypt

# Cloudflare static-asset headers. The install one-liners pipe these into a
# shell, so they must be served as text.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# Content-hashed build assets (the rule vinext writes when this file is absent).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

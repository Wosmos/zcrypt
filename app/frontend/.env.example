NEXT_PUBLIC_API_URL="http://localhost:8080"
NEXT_PUBLIC_SITE_URL="https://zcrypt.cloud"
NEXT_PUBLIC_CONTACT_EMAIL="you@example.com"
NEXT_PUBLIC_GITHUB_REPO="https://github.com/Wosmos/zcrypt"
# Cloudflare Turnstile site key for the sign-up/sign-in bot check (set TURNSTILE_SECRET_KEY on the backend too).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Cloudflare Web Analytics token (Web Analytics -> add site). Empty turns analytics off.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=""

# Server-side only (Worker secrets on Cloudflare, never NEXT_PUBLIC_):
# Shared with the backend's ZCRYPT_PROXY_SECRET; the /api proxy sends it so the
# backend trusts the visitor address and location headers. Generate: openssl rand -hex 32
ZCRYPT_PROXY_SECRET=""
# Set to 1 to send the Content-Security-Policy as Report-Only instead of enforcing it.
# CSP_REPORT_ONLY=1

# Backend origin baked into LOCAL desktop/Android builds (build-frontend.sh,
# build-desktop.sh). Copy to scripts/desktop.env (gitignored) and set it to the
# live backend. CI does NOT read this file — it uses the DESKTOP_API_URL
# repository variable (GitHub → Settings → Secrets and variables → Actions →
# Variables); keep the two in sync when the backend host changes.
DESKTOP_API_URL=https://www.zcrypt.cloud

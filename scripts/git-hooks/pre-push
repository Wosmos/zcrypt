#!/usr/bin/env bash
#
# pre-push: quality gates run in CI (.github/workflows/ci.yml), not on this
# machine. Set PREPUSH_LOCAL=1 to run the full local suite deliberately.
#
set -uo pipefail

[ "${PREPUSH_LOCAL:-0}" = 1 ] || exit 0
ROOT="$(git rev-parse --show-toplevel)"
exec bash "$ROOT/scripts/prepush.sh" --gates-only --enforce --ratchet

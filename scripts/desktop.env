# Single source of truth for the backend URL baked into desktop/mobile static
# exports (no Next.js rewrites there, so the API host must be baked in at
# build time). Sourced by build-frontend.sh and build-desktop.sh; CI
# (device.yml) reads the matching DESKTOP_API_URL repo variable instead so it
# doesn't need to check out and parse this file mid-workflow — keep both in
# sync when this changes.
#
# THROWAWAY RAILWAY URL — per docs/backend hosting migration notes, this
# project is being moved off Railway (to Oracle Always Free). Update this the
# moment a stable custom domain (e.g. api.zcrypt.cloud) is actually live —
# confirmed NOT resolving yet as of 2026-08-04.
DESKTOP_API_URL=https://zcrypt-production-f608.up.railway.app

{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Grep",
      "Glob",
      "Bash(git fetch *)",
      "Bash(gh pr *)",
      "Bash(gh secret *)",
      "Bash(git merge *)",
      "Bash(git branch *)",
      "Bash(dig +short api.zcrypt.cloud)",
      "Bash(curl -sv --max-time 10 https://api.zcrypt.cloud/api/health)",
      "Bash(dig +short NS zcrypt.cloud)",
      "Bash(dig +short zcrypt.cloud)",
      "Bash(dig +short A zcrypt.cloud)",
      "Bash(dig +short www.zcrypt.cloud)",
      "Bash(dig +short TXT zcrypt.cloud)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "qdrant-skills@claude-plugins-official": true
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser",
        "chromium"
      ]
    }
  }
}

# Docker load-testing sandbox environment (docker-compose.loadtest.yml).
#
#   cp .env.loadtest.example .env.loadtest
#
# .env.loadtest is gitignored, same as app/backend/.env. This stack is
# entirely local/disposable: it never points at the real Neon DB and never
# holds a real GitHub/GitLab/HuggingFace/Telegram token. See
# app/backend/.env.example for the full description of every var below.

# Points at the `postgres` service in docker-compose.loadtest.yml, not Neon.
DATABASE_URL=postgresql://zcrypt:loadtest@postgres:5432/zcrypt_loadtest?sslmode=disable

# Generate FRESH values for this sandbox -- never reuse a real/prod key here:
#   openssl rand -hex 32
MASTER_KEY=replace-with-a-fresh-32-byte-hex-key
ZCRYPT_JWT_SECRET=replace-with-a-fresh-32-byte-hex-key

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000

# ── OAuth / Email: left unset on purpose ───────────────────────────────────
# k6 never exercises these code paths; with these empty the server treats
# both providers as "not configured" and email verification is auto-skipped
# (see cmd/auth.go's HandleRegister: EmailVerified=true when Email config is
# nil), exactly like the config.js helpers already assume.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM=

ZCRYPT_PORT=8080

# Disables rate limiting so k6 VUs (all originating from the same container
# network) don't get 429'd. NEVER set this in a real deployment.
DEV_MODE=true

# The single safety gate for the "mock" storage platform (app/backend/adapters/mock.go).
# Unset (the default everywhere else, including real prod) means "mock" is
# rejected exactly like any other unsupported platform name.
ZCRYPT_ENABLE_MOCK_ADAPTER=true

# Where the mock adapter persists chunks (see docker-compose.loadtest.yml's
# backend volume) -- survives container restarts during a soak run.
MOCK_ADAPTER_DIR=/data/mock-storage

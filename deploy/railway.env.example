# Copy to deploy/railway.env (gitignored) and fill in. Blank values are skipped.
# Required: DATABASE_URL, MASTER_KEY, ZCRYPT_JWT_SECRET. Copy them from the old
# service unchanged, or every stored file and session becomes unreadable.
DATABASE_URL=
MASTER_KEY=
ZCRYPT_JWT_SECRET=

# Public URLs. BACKEND_URL is the new Railway domain (known after the flip);
# FRONTEND_URL / ALLOWED_ORIGINS stay on the real site.
BACKEND_URL=
FRONTEND_URL=https://www.zcrypt.cloud
ALLOWED_ORIGINS=https://www.zcrypt.cloud

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email
RESEND_API_KEY=
RESEND_FROM=

# Ops
ZCRYPT_TRUSTED_PROXY_COUNT=1
MAINTENANCE_SECRET=
METRICS_TOKEN=
ZCRYPT_CHUNK_CACHE_MB=

# Key rotation only (leave blank normally)
MASTER_KEY_OLD=
MASTER_KEY_NEW=

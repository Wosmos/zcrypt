# Copy to deploy/railway.env (gitignored) and fill in. Blank values are skipped.
# Required: DATABASE_URL, MASTER_KEY, ZCRYPT_JWT_SECRET. Copy them from the old
# service unchanged, or every stored file and session becomes unreadable.
DATABASE_URL=
MASTER_KEY=
ZCRYPT_JWT_SECRET=

# Public URLs. All three stay on the real site: the browser reaches the API
# through www.zcrypt.cloud/api (the Cloudflare Worker's rewrite), so OAuth callbacks never move.
BACKEND_URL=https://www.zcrypt.cloud
FRONTEND_URL=https://www.zcrypt.cloud
ALLOWED_ORIGINS=https://www.zcrypt.cloud

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email
RESEND_API_KEY=
RESEND_FROM=

# Abuse protection. ZCRYPT_PROXY_SECRET must equal the Cloudflare Worker secret
# of the same name; TURNSTILE_SECRET_KEY pairs with the site's
# NEXT_PUBLIC_TURNSTILE_SITE_KEY. ZCRYPT_CLOUD_NETWORKS: block, flag or off.
ZCRYPT_PROXY_SECRET=
TURNSTILE_SECRET_KEY=
ZCRYPT_CLOUD_NETWORKS=

# Ops
ZCRYPT_TRUSTED_PROXY_COUNT=1
MAINTENANCE_SECRET=
METRICS_TOKEN=
ZCRYPT_CHUNK_CACHE_MB=

# Key rotation only (leave blank normally)
MASTER_KEY_OLD=
MASTER_KEY_NEW=
